<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 12mm 14mm; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; color: #1a202c; font-size: 9.2pt; line-height: 1.38; }
  a { color: #1a202c; text-decoration: none; }
  .name { font-size: 21pt; font-weight: 700; letter-spacing: -0.3px; }
  .headline { font-size: 10.5pt; font-weight: 600; color: #0b76b7; margin-top: 1mm; }
  .contact { font-size: 8.4pt; color: #4a5568; margin-top: 1.6mm; }
  .contact span + span::before { content: " · "; color: #a0aec0; }
  h2 { font-size: 9.6pt; text-transform: uppercase; letter-spacing: 1.2px; color: #0b76b7;
       border-bottom: 0.6pt solid #cbd5e0; padding-bottom: 1mm; margin: 3.6mm 0 1.8mm; }
  .summary { color: #2d3748; }
  .skill-row { display: flex; margin-bottom: 0.9mm; }
  .skill-k { font-weight: 600; width: 34mm; flex: none; color: #2d3748; }
  .skill-v { color: #2d3748; }
  .proj { margin-bottom: 2.2mm; }
  .proj-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; column-gap: 4mm; }
  .proj-name { font-weight: 700; font-size: 9.8pt; }
  .proj-stack { font-size: 8.2pt; color: #718096; }
  .proj-link { font-size: 8.2pt; color: #0b76b7; }
  ul { margin: 0.8mm 0 0 4mm; }
  li { margin-bottom: 0.6mm; color: #2d3748; }
  li::marker { color: #0b76b7; }
  .edu { display: flex; justify-content: space-between; align-items: baseline; }
  .edu-name { font-weight: 700; }
  .muted { color: #4a5568; }
  .small { font-size: 8.4pt; color: #718096; }
</style>
</head>
<body>
  <div class="name">{{ id.name }}</div>
  <div class="headline">{{ v.headline }}</div>
  <div class="contact">
    <span>{{ id.city }}</span>
    <span><a href="mailto:{{ id.email }}">{{ id.email }}</a></span>
    <span><a href="{{ id.github_url }}">{{ id.github }}</a></span>
    <span><a href="{{ id.linkedin_url }}">{{ id.linkedin }}</a></span>
    <span><a href="{{ id.portfolio_url }}">{{ id.portfolio }}</a></span>
  </div>

  <h2>Summary</h2>
  <p class="summary">{{ v.summary }}</p>

  <h2>Skills</h2>
  {% for key in v.skills_order %}
  <div class="skill-row"><div class="skill-k">{{ skill_labels[key] }}</div><div class="skill-v">{{ skills[key] }}</div></div>
  {% endfor %}

  <h2>Projects</h2>
  {% for pkey in v.projects %}{% set p = projects[pkey] %}
  <div class="proj">
    <div class="proj-head">
      <span class="proj-name">{{ p.name }}{% if p.link %} · <a class="proj-link" href="https://{{ p.link }}">{{ p.link }}</a>{% endif %}</span>
      <span class="proj-stack">{{ p.stack }}</span>
    </div>
    <ul>
      {% for b in p.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
  </div>
  {% endfor %}

  <h2>Education</h2>
  <div class="edu">
    <div>
      <div class="edu-name">{{ edu.degree }}, {{ edu.faculty }}</div>
      <div class="muted">{{ edu.university }} · {{ edu.gpa }}</div>
    </div>
    <div class="muted">{{ edu.years }}</div>
  </div>

  <h2>Languages</h2>
  <p class="muted">{{ languages | join(' · ') }}</p>
</body>
</html>
