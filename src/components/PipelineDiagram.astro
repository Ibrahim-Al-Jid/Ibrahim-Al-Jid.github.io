---
import type { Lang } from '../data/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const stages = lang === 'ar'
  ? ['فكرة', 'تخطيط', 'تنفيذ', 'مراجعة', 'اختبار', 'دمج بشري']
  : ['Idea', 'Plan', 'Build', 'Review', 'Test gate', 'Merge'];
---
<div class="card p-6 overflow-hidden" aria-label={lang === 'ar' ? 'مخطط خط سير الوكلاء' : 'Agent pipeline diagram'}>
  <svg viewBox="0 0 900 120" class="w-full h-auto" role="img" aria-hidden="true" dir="ltr">
    {stages.map((_, i) => {
      if (i === stages.length - 1) return null;
      const x1 = 60 + i * 156 + 40;
      return (
        <line class="pipe-edge" x1={x1} y1="60" x2={60 + (i + 1) * 156 - 48} y2="60"
          stroke="#0ea5e9" stroke-opacity="0.55" stroke-width="2" stroke-dasharray="6 6" />
      );
    })}
    {stages.map((s, i) => (
      <g class="pipe-node">
        <circle cx={60 + i * 156} cy="60" r="34" fill="#0f172a" stroke="#0ea5e9" stroke-width="1.5" />
        <text x={60 + i * 156} y="60" text-anchor="middle" dominant-baseline="middle"
          fill="#e2e8f0" font-size="11" font-family="JetBrains Mono, monospace">{s}</text>
      </g>
    ))}
  </svg>
</div>
<style>
  .pipe-edge { animation: dash 1.6s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -24; } }
  .pipe-node { animation: pulse 3s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
  .pipe-node:nth-of-type(2n) { animation-delay: 0.4s; }
  @keyframes pulse { 0%, 100% { opacity: 0.85; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .pipe-edge, .pipe-node { animation: none; }
  }
</style>
