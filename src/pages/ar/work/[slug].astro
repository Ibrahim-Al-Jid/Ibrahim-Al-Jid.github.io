---
import Base from '../../../layouts/Base.astro';
import { caseStudies } from '../../../data/caseStudies';
import { ui } from '../../../data/content';

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const cs = caseStudies.find((c) => c.slug === slug)!;
const t = ui.ar;
---
<Base lang="ar" title={`${cs.titleAr} — إبراهيم حمدي`} description={cs.sections[0].body.ar}>
  <article class="max-w-3xl mx-auto px-5 pt-32 pb-20">
    <a href="/ar/#agents" class="chip hover:border-[var(--color-accent)] transition-colors">→ {t.nav.agents}</a>
    <div class="mt-6 flex items-center gap-3">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">{cs.titleAr}</h1>
      {cs.privateRepo && <span class="chip">خاص</span>}
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      {cs.stack.map((x) => <span class="chip">{x}</span>)}
    </div>
    {cs.repo && (
      <a href={cs.repo} target="_blank" rel="noopener" class="inline-block mt-4 text-[var(--color-accent)] hover:underline">{t.viewRepo} ↗</a>
    )}
    {cs.privateRepo && <p class="mt-4 text-sm text-[var(--color-muted)]">{t.privateNote}</p>}
    <div class="mt-10 space-y-8">
      {cs.sections.map((s) => (
        <section class="reveal">
          <h2 class="font-mono text-sm tracking-wider text-[var(--color-accent)]">{s.heading.ar}</h2>
          <p class="mt-2 text-[var(--color-muted)] leading-relaxed">{s.body.ar}</p>
        </section>
      ))}
    </div>
  </article>
</Base>
